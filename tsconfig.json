{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node", "webdriverio", "@wdio/globals/types", "chai"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}