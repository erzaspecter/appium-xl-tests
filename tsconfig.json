@'
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node", "webdriverio"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
'@ | Out-File -FilePath tsconfig.json -Encoding utf8